{
    "name": "innoboxrr/livewire-comments",
    "description": "Componente Livewire que incrusta el sistema de comentarios externo de Innoboxrr y rutas para listar los comentarios de un bloque o de un usuario.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LivewireComments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LivewireComments\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Homero Ra"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^3.7.11 || ^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^9.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LivewireComments\\Providers\\AppServiceProvider",
                "Innoboxrr\\LivewireComments\\Providers\\AuthServiceProvider",
                "Innoboxrr\\LivewireComments\\Providers\\EventServiceProvider",
                "Innoboxrr\\LivewireComments\\Providers\\RouteServiceProvider"
            ]
        }
    }
}
